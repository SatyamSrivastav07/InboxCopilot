# Copy to .env for Docker Compose. Never commit live values.
APP_ENV=development
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=1000000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

POSTGRES_DB=inbox_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_locally
DATABASE_URL=postgresql+psycopg2://postgres:change_me_locally@postgres:5432/inbox_copilot

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_TTL_SECONDS=60
GENAI_MAX_RETRIES=3
SYNC_LOCK_TTL_SECONDS=1800
QUEUED_JOB_STALE_SECONDS=120

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
GMAIL_TOKEN_FILE=/app/runtime/token.json
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

CHROMA_PERSIST_DIRECTORY=/app/data/chromadb
CHROMA_COLLECTION_NAME=inbox_emails
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.2
EMAIL_CHUNK_SIZE=1000
EMAIL_CHUNK_OVERLAP=100
REPLY_THREAD_MAX_CHARS=12000
REPLY_THREAD_RECENT_MESSAGES=8
